{
  "name": "bevy-mcp",
  "version": "0.20.0",
  "description": "MCP server giving agents version-accurate Bevy API docs, guides, examples and migration notes",
  "type": "module",
  "main": "index.js",
  "bin": {
    "bevy-mcp": "bin/bevy-mcp.js"
  },
  "files": [
    "index.js",
    "bin/*.js",
    "build/index.js",
    "build/index.js.map",
    "build/server.js",
    "build/server.js.map",
    "build/bin/",
    "build/src/",
    "build/scripts/",
    "scripts/*.mjs",
    "vendor/",
    "README.md",
    "GETTING-API-DOCS.md",
    "TROUBLESHOOTING.md",
    "HOW-IT-WORKS.md",
    "PUBLISHING.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "server.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build/scripts/generate-launchers.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node index.js",
    "fetch-index": "node scripts/fetch-index.mjs",
    "fetch-docs": "node scripts/fetch-docs.mjs",
    "fetch-website": "node scripts/fetch-website.mjs",
    "publish-index": "node scripts/publish-index.mjs",
    "build-index": "node scripts/build-index.mjs",
    "reindex": "node scripts/build-index.mjs --force",
    "test": "npm run build && node build/test/index.mjs",
    "test:unit": "npm run build && node build/test/run-tests.mjs",
    "test:package": "npm run build && node build/scripts/package-smoke.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bevy",
    "rust",
    "gamedev",
    "documentation",
    "ai"
  ],
  "license": "MIT",
  "author": "kinkirill",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinkirill/bevy_manual_mcp.git"
  },
  "homepage": "https://github.com/kinkirill/bevy_manual_mcp#readme",
  "bugs": {
    "url": "https://github.com/kinkirill/bevy_manual_mcp/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cheerio": "^1.2.0",
    "flexsearch": "^0.8.212",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
